<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window on Windows. Program attaches to the launching terminal's console when there is one. -->
    <OutputType>WinExe</OutputType>
    <Product>Cuepoint</Product>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <!-- What the app is, for its file's Properties in Explorer, the version switch, and the release package's name. Raise the
         version for each release; the build adds the commit it was made from to the informational version. -->
    <Version>1.0.0</Version>
    <AssemblyTitle>Cuepoint DJ Controller</AssemblyTitle>
    <Description>Two-deck DJ software for Windows: beat-synced decks, stems, hot cues, MIDI controllers, recording and live streaming.</Description>
    <Authors>Steve 'Sly' Williams</Authors>
    <Company>Konaju Games</Company>
    <Copyright>Copyright (c) 2026 Steve 'Sly' Williams</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/KonajuGames/cuepoint-dj-controller</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The executable's icon in Explorer and the taskbar; Assets\draw_assets.py makes it from the logo. -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <!-- A release package (dotnet publish -r win-x64, as tools\package.ps1 does) carries the .NET runtime with it, so
         it runs on a computer without .NET installed. -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl" Version="2026.10.3" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Mixer" Version="2026.10.3" />
    <PackageReference Include="Concentus" Version="2.2.3" />
    <!-- Stem separation: Demucs through ONNX Runtime, on the graphics card with DirectML. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.AI.DirectML" Version="1.15.4" GeneratePathProperty="true" />
    <PackageReference Include="NAudio.Wasapi" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- DirectML's package only copies its DLL for a build with a platform, and without it Windows' own older copy is
         found, which ONNX Runtime can't use. -->
    <None Include="$(PkgMicrosoft_AI_DirectML)/bin/x64-win/DirectML.dll" Link="DirectML.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Images, by file name; Assets\draw_assets.py draws them. -->
    <EmbeddedResource Include="Assets\*.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window, rendering and UI code the Cue apps share (BRUTAL's GLFW, Vulkan, FreeType and the rest come with
         it, and the UI's shaders). It's a sibling checkout: cue-framework beside this repository. -->
    <ProjectReference Include="..\..\cue-framework\Cue.Framework\Cue.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ByteSize, ElementCount, Ptr and friends. -->
    <Using Include="Brutal" />
    <!-- The framework's, everywhere, as if its classes were the app's own. -->
    <Using Include="Cue.Framework" />
    <Using Include="Cue.Framework.Rendering" />
    <Using Include="Cue.Framework.UI" />
    <Using Include="Cue.Framework.Window" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the app's own classes, which are internal to it. -->
    <InternalsVisibleTo Include="Cuepoint.Tests" />
  </ItemGroup>

</Project>
